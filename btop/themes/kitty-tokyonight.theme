# btop theme matching kitty Tokyo Night colors
# No black backgrounds - uses terminal transparency

# Main background and text
theme[main_bg]=""
theme[main_fg]="#c0caf5"

# Title color
theme[title]="#c0caf5"

# Highlight color
theme[hi_fg]="#7aa2f7"

# Selected item
theme[selected_bg]="#414868"
theme[selected_fg]="#c0caf5"

# Inactive text
theme[inactive_fg]="#414868"

# Graph text
theme[graph_text]="#a9b1d6"

# Meter background
theme[meter_bg]="#414868"

# Process box
theme[proc_misc]="#7aa2f7"

# Box outlines
theme[cpu_box]="#7aa2f7"
theme[mem_box]="#9ece6a"
theme[net_box]="#e0af68"
theme[proc_box]="#bb9af7"

# CPU graph colors (gradient)
theme[cpu_start]="#9ece6a"
theme[cpu_mid]="#e0af68"
theme[cpu_end]="#f7768e"

# Memory
theme[used_start]="#9ece6a"
theme[used_mid]="#e0af68"
theme[used_end]="#f7768e"

# Available memory
theme[available_start]="#7aa2f7"
theme[available_mid]="#7dcfff"
theme[available_end]="#bb9af7"

# Cached memory
theme[cached_start]="#414868"
theme[cached_mid]="#7aa2f7"
theme[cached_end]="#7dcfff"

# Swap
theme[swap_start]="#e0af68"
theme[swap_mid]="#f7768e"
theme[swap_end]="#f7768e"

# Free memory
theme[free_start]="#414868"
theme[free_mid]="#414868"
theme[free_end]="#414868"

# Download
theme[download_start]="#7dcfff"
theme[download_mid]="#7aa2f7"
theme[download_end]="#bb9af7"

# Upload
theme[upload_start]="#9ece6a"
theme[upload_mid]="#e0af68"
theme[upload_end]="#f7768e"

# Process colors
theme[process_start]="#7dcfff"
theme[process_mid]="#bb9af7"
theme[process_end]="#f7768e"

# Temperature
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"
